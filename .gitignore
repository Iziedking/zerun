# Secrets and local environment. Never commit these.
.env
.env.*
!.env.example

# Internal planning notes. Not for the public repo.
0g.md
todo.md
todo-*.md

# Host-specific compose overrides. These carry infra that belongs to one box (for
# example the shared-Caddy network wiring), not the repo. Keeping them untracked is
# also what lets the CI's `git pull --ff-only` succeed: the tracked compose file
# stays clean, and box-specific deltas live here instead of as local edits to it.
deploy/*.override.yml
deploy/telt-network.override.yml

# Node
node_modules/
.pnpm-store/
dist/
build/
*.log
npm-debug.log*
pnpm-debug.log*

# Next.js
.next/
out/
.vercel/

# Foundry
contracts/out/
contracts/cache/
contracts/broadcast/
# Vendored dependencies. Restore on a fresh clone with:
#   cd contracts && forge install foundry-rs/forge-std \
#     OpenZeppelin/openzeppelin-contracts@v5.0.2 \
#     OpenZeppelin/openzeppelin-contracts-upgradeable@v5.0.2
# (the upgradeable package's own nested test submodules may fail on Windows long
#  paths; that is harmless, the build resolves @openzeppelin/contracts to the
#  top-level openzeppelin-contracts via remappings.txt.)
contracts/lib/

# Misc
.DS_Store
coverage/
*.tsbuildinfo

# Brand/demo assets (local only)

# Reference/sample images (third-party stock, local inspiration only). Never commit.
sample/

.vercel
.env*.local

