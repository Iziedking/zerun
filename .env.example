# Copy to .env and fill in. The real .env is gitignored. Never commit secrets.

# Deployer and coordinator wallet. Funds deploys, posts score roots, settles,
# and pays for inference on 0G Compute. Generate one with: cast wallet new
DEPLOYER_PRIVATE_KEY=0x...

# 0G Galileo testnet
OG_RPC_URL=https://evmrpc-testnet.0g.ai
OG_CHAIN_ID=16602
OG_EXPLORER=https://chainscan-galileo.0g.ai

# Optional: a separate coordinator address for the COORDINATOR_ROLE at deploy.
# Defaults to the deployer.
# COORDINATOR_ADDRESS=0x...

# How the agents reach 0G Compute.
#   broker      paid, TEE-verifiable calls through the serving broker (default
#               when a key is set). This is the real proof path.
#   router      the 0G Compute Router (OpenAI-compatible single endpoint)
#   stub        offline deterministic answers, for local plumbing tests only
COMPUTE_MODE=broker
COMPUTE_LEDGER_OG=3
COMPUTE_PROVIDER_OG=1
# Pin a known-good provider address. Empty means auto-pick the first live one.
# COMPUTE_PROVIDER=0x...
COMPUTE_TIMEOUT_MS=60000
# The broker signs single-use headers per request and they collide if two overlap, so
# every call is serialized through one global queue. This is the minimum gap between
# call starts; ~7s keeps a full field under the provider's ~10 req/min cap.
# COMPUTE_MIN_INTERVAL_MS=7000
# Cap on each 0G broker SDK call (broker creation, ledger funding, header signing, TEE
# verification). These hit the chain and have no timeout of their own.
# COMPUTE_BROKER_TIMEOUT_MS=45000
# Cap on a non-final (premium model) attempt, so a down provider fails fast and the
# healthy fallback still runs inside the contest's budget.
# COMPUTE_PREMIUM_ATTEMPT_MS=30000
# How long a successful ledger balance check stays trusted before it is re-read.
# COMPUTE_LEDGER_RECHECK_MS=60000

# Router fallback (only used when COMPUTE_MODE=router)
# COMPUTE_ROUTER_BASE_URL=
# COMPUTE_ROUTER_API_KEY=
# COMPUTE_ROUTER_MODEL=llama-3.3-70b-instruct

# Mainnet 0G Compute (paid with REAL 0G). Inference is decoupled from the contract
# chain: the arena's contracts stay on the testnet above, but when the mainnet compute
# RPC + a FUNDED wallet are set here, every agent call goes to MAINNET first (the real
# model catalog, TEE-verifiable) and only falls back to the testnet compute wallet above
# per-call if mainnet fails. Leave unset for testnet-only (the current behavior).
#   COMPUTE_MAINNET_RPC_URL=https://evmrpc.0g.ai
#   COMPUTE_MAINNET_CHAIN_ID=
# Wallet that pays for mainnet inference; must hold real mainnet 0G. Defaults to the
# deployer key (same address, funded on mainnet). Set a dedicated key to keep it separate.
#   COMPUTE_MAINNET_PRIVATE_KEY=0x...
#   COMPUTE_MAINNET_LEDGER_OG=3
#   COMPUTE_MAINNET_PROVIDER_OG=1
#   COMPUTE_MAINNET_PROVIDER=0x...   # pin a known-good mainnet provider (optional)
# Circuit breaker on the mainnet leg. Without it a sustained mainnet outage makes every
# call pay the full mainnet attempt before falling back. After this many consecutive
# mainnet failures, skip it for the cooldown, then probe again.
#   COMPUTE_MAINNET_TRIP=2
#   COMPUTE_MAINNET_COOLDOWN_MS=120000

# 0G Storage. When STORAGE_MODE=on, the full solve-feed audit trail is uploaded
# to 0G Storage after each contest settles, and its root hash is shown in the UI.
STORAGE_MODE=off
# Bound the storage network calls. A download runs on the request path (serving an agent
# skin), so an unbounded stall would hang the handler until the gateway kills it.
# ZG_STORAGE_UPLOAD_TIMEOUT_MS=45000
# ZG_STORAGE_DOWNLOAD_TIMEOUT_MS=12000
STORAGE_INDEXER_RPC=https://indexer-storage-testnet-turbo.0g.ai

# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/zerun

# Backend HTTP port
PORT=8787

# Optional admin token gating the demo endpoints. Empty leaves them open on the
# testnet build.
# ADMIN_TOKEN=

# Agent memory (retrieved-context evolution). When on, an agent's own recent play is
# summarized on 0G Compute after each contest, anchored on 0G Storage, and injected into
# its next Solver/Analyst prompt. Off by default so the lift can be A/B measured against
# the memory-off control (GET /api/memory/lift). Set to 1 to enable.
# AGENT_MEMORY=1
#
# Memory runs OFF the settle path (queued after the payout lands) and every knob below
# exists so it can never hang a contest, churn 0G calls, or store a note it cannot prove.
# When STORAGE_MODE=on and the 0G Storage anchor fails, the memory is NOT written: the
# agent keeps its previous, anchored memory rather than gaining an unauditable edge.
#
# Graded answers an agent needs before its first summary means anything.
# AGENT_MEMORY_MIN_GRADED=3
# New graded answers required since the last summary. Without this an agent is
# re-summarized after every contest even when it learned nothing new.
# AGENT_MEMORY_MIN_NEW_GRADED=1
# Optional floor between two summaries for one agent. 0 disables it.
# AGENT_MEMORY_COOLDOWN_MS=0
# Hard bound on one agent's whole update (0G summarize + Storage anchor + write).
# AGENT_MEMORY_UPDATE_TIMEOUT_MS=120000
# The background queue drops overflow instead of growing without limit.
# AGENT_MEMORY_QUEUE_MAX=64
# Longest note injected into a prompt, so memory cannot crowd out the task.
# AGENT_MEMORY_HINT_CHARS=400

# Chess tournaments. A tournament has no join window: it opens as a lobby and starts the
# moment every seat fills, otherwise the house fills the empty seats at the deadline.
# CHESS_TOURNEY_SEATS=8
# CHESS_LOBBY_SECONDS=600
# CHESS_LOBBY_POLL_MS=5000
# Per-match caps. When the clock or the ply limit runs out, captured material decides the
# winner, then Compute tier, then the lower agent id.
# CHESS_MATCH_SECONDS=300
# CHESS_MAX_PLY=300
# How many engine candidate moves the 0G call chooses among each turn.
# CHESS_CANDIDATES=3
# CHESS_MIN_MOVE_MS=300

# Frontend: where the browser reaches the backend.
NEXT_PUBLIC_API_URL=http://localhost:8787
